# ===== КЛИО · myclio.ru · конфиг для хостинга Beget (Apache) =====

# --- MIME-типы ---
AddType application/vnd.android.package-archive .apk
AddType application/manifest+json .webmanifest
AddType image/webp .webp

# --- Сжатие текстовых типов (gzip) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/ld+json image/svg+xml application/manifest+json
</IfModule>

# --- Кэширование ---
<IfModule mod_expires.c>
  ExpiresActive On
  # картинки — год (immutable: файлы не меняются, при замене меняется имя)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # приложение
  ExpiresByType application/vnd.android.package-archive "access plus 1 month"
  # html — всегда проверять свежесть
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Канонический адрес: https://myclio.ru (один 301-редирект для всех зеркал) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # внутренний алиас: /api/lead → /api/lead.php (POST сохраняется, внешнего редиректа нет)
  RewriteRule ^api/lead/?$ api/lead.php [L]
  # www и http → https://myclio.ru за один прыжок
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://myclio.ru%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Базовые защитные заголовки (не ломают Метрику, Dikidi, карты) ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
