# rating.json и content.json отдаются кросс-доменно: приложение (APK) работает с file:// и делает запрос с «пустого» origin
<IfModule mod_headers.c>
  <FilesMatch "^(rating|content)\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType application/json .json
